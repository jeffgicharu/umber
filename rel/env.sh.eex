#!/bin/sh
# Umber's release environment.
#
# Erlang distribution stays off: the two copies of the app that run during a
# release talk through PostgreSQL, and nothing listens on port 4369 on a
# server without a firewall.
export RELEASE_DISTRIBUTION=none
export RELEASE_NODE=umber

# Modules load when first used rather than all at start: 88 MB resident
# instead of 186 MB, measured with two schedulers. The release check fetches
# every page before visitors arrive, so they never wait on a module loading.
export RELEASE_MODE=interactive
