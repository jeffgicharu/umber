<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>A pause in the sale · Umber</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body>
    <main class="error-page wrap">
      <a class="wordmark" href="/"><span class="name">Umber</span><span class="place">Auctioneers · Nairobi</span></a>
      <div class="error-body">
        <p class="label">A pause in the sale</p>
        <h1>Something went wrong on our side.</h1>
        <p>
          Your bids are safe: a bid is only ever shown as accepted once it has been recorded. Please try the page again in a moment.
        </p>
        <div class="error-actions">
          <a class="btn" href="/">Back to the front page
          <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </main>
  </body>
</html>
