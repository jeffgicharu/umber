<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lot withdrawn · Umber</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/images/brand/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body>
    <main class="error-page wrap">
      <a class="wordmark" href="/"><span class="name">Umber</span><span class="place">Auctioneers · Nairobi</span></a>
      <div class="error-body">
        <p class="label">Lot</p>
        <p class="error-number serif num" aria-hidden="true">404</p>
        <h1>This page has been withdrawn from sale.</h1>
        <p>
          The address may be mistyped, or the lot may belong to a sale that has closed and been taken down.
        </p>
        <div class="error-actions">
          <a class="btn" href="/sales">See current sales
          <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn ghost" href="/">The front page</a>
        </div>
      </div>
    </main>
  </body>
</html>
