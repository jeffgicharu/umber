<Layouts.app flash={@flash} current_user={@current_user} active={:terms}>
  <header class="page-head wrap">
    <p class="label">Terms of use</p>
    <h1>Using this website</h1>
  </header>
  <div class="wrap legal prose">
    <p>
      This website is run by Umber Auctioneers Ltd of Umber House, Lenana Road, Nairobi. Bidding is governed by our <a href={
        ~p"/conditions"
      }>conditions of sale</a>; these terms cover the rest of the site.
    </p>
    <h2>Pictures and text</h2>
    <p>
      The photographs and catalogue texts are ours or are used with permission. You may share links to lots and quote short passages; please do not copy the pictures for other uses.
    </p>
    <h2>Your account</h2>
    <p>
      Keep your password to yourself. Bids placed from your account are yours. Tell us at once if you think someone else has used it.
    </p>
    <h2>Availability</h2>
    <p>
      We work hard to keep the site running through every sale. If it is unavailable during a live sale, the auctioneer will pause until online bidding is restored.
    </p>
  </div>
</Layouts.app>
